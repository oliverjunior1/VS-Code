   "outputs": [],
   "source": [
    "def column_mean(values):\n",
    "    array = np.asarray(values, dtype = float)\n",
    "    if array.ndim != 2:\n",
    "        raise ValueError(\"Expected a matrix\")\n",
    "    return array.mean(axis=0)"
   ]
  }
